{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://taskbarwidgets.dev/schemas/widget-v4.schema.json",
  "title": "Taskbar Widgets Community Manifest v4",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "version",
    "minHostVersion",
    "displayName",
    "description",
    "author",
    "size",
    "renderer",
    "permissions"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 4 },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9.-]{2,127}\\.[a-z0-9.-]+$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "minHostVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "displayName": { "type": "string", "minLength": 1, "maxLength": 80 },
    "description": { "type": "string", "minLength": 1, "maxLength": 500 },
    "category": { "type": "string", "maxLength": 40 },
    "author": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "website": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        }
      }
    },
    "size": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {
        "width": { "type": "integer", "minimum": 32, "maximum": 480 },
        "height": { "type": "integer", "minimum": 24, "maximum": 48 }
      }
    },
    "renderer": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "entry"],
          "properties": {
            "type": { "const": "declarative" },
            "entry": {
              "type": "string",
              "pattern": "^(?!.*\\.\\.)[^\\\\]+\\.json$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "entry"],
          "properties": {
            "type": { "const": "web" },
            "entry": {
              "type": "string",
              "pattern": "^(?!.*\\.\\.)[^\\\\]+\\.html$"
            },
            "expandedSize": {
              "type": "object",
              "additionalProperties": false,
              "required": ["width", "height"],
              "properties": {
                "width": { "type": "integer", "minimum": 32, "maximum": 640 },
                "height": { "type": "integer", "minimum": 24, "maximum": 480 }
              }
            },
            "expandDirection": { "enum": ["auto", "up", "down"], "default": "auto" },
            "activation": { "enum": ["hover", "click", "manual"], "default": "hover" },
            "hoverDelayMs": { "type": "integer", "minimum": 0, "maximum": 1000 },
            "collapseDelayMs": { "type": "integer", "minimum": 0, "maximum": 2000 },
            "transitionMs": { "type": "integer", "minimum": 0, "maximum": 500 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "entry"],
          "properties": {
            "type": { "const": "native" },
            "entry": {
              "type": "string",
              "pattern": "^(?!.*\\.\\.)[^\\\\]+\\.json$"
            },
            "expandedEntry": {
              "type": "string",
              "pattern": "^(?!.*\\.\\.)[^\\\\]+\\.json$"
            },
            "expandedSize": {
              "type": "object",
              "additionalProperties": false,
              "required": ["width", "height"],
              "properties": {
                "width": { "type": "integer", "minimum": 32, "maximum": 640 },
                "height": { "type": "integer", "minimum": 24, "maximum": 480 }
              }
            },
            "expandDirection": { "enum": ["auto", "up", "down"], "default": "auto" },
            "activation": { "enum": ["hover", "click", "manual"], "default": "click" }
          }
        }
      ]
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provider": {
          "type": "object",
          "required": ["type"],
          "properties": {
            "type": { "enum": ["static", "clock", "http-json", "javascript"] },
            "path": { "type": "string", "pattern": "^[^/\\\\]+\\.js$" },
            "url": { "type": "string", "format": "uri", "pattern": "^https://" },
            "refreshSeconds": { "type": "number", "minimum": 1, "maximum": 3600 },
            "data": { "type": "object" }
          }
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "entry"],
      "properties": {
        "type": { "const": "process" },
        "entry": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240,
          "pattern": "^(?!.*\\.\\.)[^\\\\].*$"
        },
        "arguments": {
          "type": "array",
          "maxItems": 64,
          "items": { "type": "string", "maxLength": 1024 }
        },
        "protocol": { "enum": ["none", "json-lines-v1"], "default": "json-lines-v1" },
        "lifetime": { "const": "persistent", "default": "persistent" },
        "runAs": { "enum": ["user", "administrator"], "default": "user" },
        "workingDirectory": { "enum": ["package", "data"], "default": "package" }
      }
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required"],
      "properties": {
        "required": {
          "type": "array",
          "maxItems": 64,
          "items": { "$ref": "#/$defs/permission" }
        },
        "optional": {
          "type": "array",
          "maxItems": 64,
          "items": { "$ref": "#/$defs/permission" }
        }
      }
    },
    "supportsMultipleInstances": { "type": "boolean", "default": false },
    "settings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["key", "type", "label", "default"],
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"
          },
          "type": { "enum": ["string", "number", "boolean", "select", "secret"] },
          "label": { "type": "string", "maxLength": 80 },
          "description": { "type": "string", "maxLength": 240 },
          "default": {}
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "required": ["runtime"] },
      "then": {
        "properties": {
          "permissions": {
            "properties": {
              "optional": { "maxItems": 0 }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "permission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "reason"],
      "properties": {
        "id": {
          "enum": [
            "accounts.list.read",
            "accounts.profile.read",
            "accounts.history.read",
            "accounts.tokens.read",
            "accounts.active.write",
            "accounts.delete",
            "filesystem.read",
            "filesystem.write",
            "filesystem.delete",
            "filesystem.watch",
            "filesystem.all",
            "registry.read",
            "registry.write",
            "registry.delete",
            "registry.all",
            "process.list",
            "process.start",
            "process.stop",
            "process.control",
            "process.inject",
            "shell.execute",
            "shell.openExternal",
            "network.internet",
            "network.local",
            "network.listen",
            "network.unrestricted",
            "windows.win32",
            "windows.winrt",
            "windows.com",
            "windows.wmi",
            "clipboard.read",
            "clipboard.write",
            "notifications.show",
            "camera",
            "microphone",
            "location",
            "bluetooth",
            "usb",
            "media.sessions.read",
            "media.playback.control",
            "steam.downloads.read",
            "steam.client.control",
            "discord.state.read",
            "system.metrics.read",
            "taskbar.control",
            "settings.read",
            "settings.write",
            "system.fullAccess",
            "system.administrator",
            "system.startup",
            "system.background"
          ]
        },
        "scope": {
          "oneOf": [
            { "type": "string", "minLength": 1, "maxLength": 1024 },
            {
              "type": "array",
              "maxItems": 64,
              "items": { "type": "string", "minLength": 1, "maxLength": 1024 }
            }
          ]
        },
        "reason": { "type": "string", "minLength": 3, "maxLength": 300 }
      }
    }
  }
}
